<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title><%= serviceName %> | Health</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: 'Avenir Next', 'Segoe UI', sans-serif;
        background: #101313;
        color: #edf5ee;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-width: 320px;
        background: #101313;
      }
      .shell {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
        padding: 64px 0 48px;
      }
      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 72px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      .mark {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #c6f06d;
        color: #17200f;
        font-weight: 900;
      }
      .environment {
        color: #9ba8a0;
        font-size: 0.84rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .hero {
        max-width: 690px;
        margin-bottom: 42px;
      }
      .eyebrow {
        color: #c6f06d;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      h1 {
        max-width: 650px;
        margin: 14px 0 18px;
        font-size: clamp(2.5rem, 7vw, 5.4rem);
        line-height: 0.98;
        letter-spacing: -0.06em;
      }
      .intro {
        color: #aebbb1;
        font-size: 1.05rem;
        line-height: 1.65;
        margin: 0;
      }
      .checks {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }
      .card {
        min-height: 190px;
        padding: 24px;
        border: 1px solid #2a3530;
        border-radius: 16px;
        background: #171c1a;
        box-shadow: 0 18px 50px #0000001a;
      }
      .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 42px;
      }
      .card h2 {
        margin: 0;
        color: #dbe7dd;
        font-size: 1rem;
        font-weight: 600;
      }
      .icon {
        color: #75857b;
        font-size: 1.2rem;
      }
      .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #c6f06d;
        font-size: 0.82rem;
        font-weight: 700;
      }
      .status::before {
        width: 8px;
        height: 8px;
        content: '';
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 14px currentColor;
      }
      .status--bad {
        color: #ff8b7d;
      }
      .value {
        margin: 0 0 8px;
        font-size: 1.65rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      .detail {
        margin: 0;
        color: #8f9f95;
        font-size: 0.9rem;
        line-height: 1.5;
      }
      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #29332e;
        color: #8f9f95;
        font-size: 0.86rem;
      }
      button {
        border: 0;
        border-radius: 9px;
        padding: 11px 16px;
        background: #c6f06d;
        color: #17200f;
        cursor: pointer;
        font: inherit;
        font-weight: 800;
      }
      button:hover {
        background: #dcff8a;
      }
      button:disabled {
        cursor: wait;
        opacity: 0.65;
      }
      .toggle {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
      }
      .toggle input {
        accent-color: #c6f06d;
      }
      footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 68px;
        color: #65736a;
        font-size: 0.78rem;
      }
      @media (max-width: 720px) {
        .shell {
          width: min(100% - 28px, 540px);
          padding-top: 32px;
        }
        .topline {
          margin-bottom: 58px;
        }
        .checks {
          grid-template-columns: 1fr;
        }
        .card {
          min-height: auto;
        }
        .card-head {
          margin-bottom: 28px;
        }
        .toolbar,
        footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topline">
        <div class="brand">
          <span class="mark">T</span><span><%= serviceName %></span>
        </div>
        <span class="environment"><%= environment %></span>
      </header>

      <section class="hero">
        <span class="eyebrow">Service health</span>
        <h1>
          Everything looks <%= overallStatus === 'healthy' ? 'healthy.' :
          'unsteady.' %>
        </h1>
        <p class="intro">
          A live snapshot of the application runtime and its database
          connection.
        </p>
      </section>

      <section class="checks" aria-label="Service checks">
        <article class="card">
          <div class="card-head">
            <h2>API service</h2>
            <span class="icon">⌁</span>
          </div>
          <p class="value"><%= apiStatus %></p>
          <p class="detail">
            The NestJS application is responding to requests.
          </p>
        </article>
        <article class="card">
          <div class="card-head">
            <h2>Database</h2>
            <span class="icon">◈</span>
          </div>
          <p class="value"><%= databaseStatus %></p>
          <p class="detail"><%= databaseMessage %></p>
        </article>
        <article class="card">
          <div class="card-head">
            <h2>Response time</h2>
            <span class="icon">↗</span>
          </div>
          <p class="value"><%= latencyMs %> ms</p>
          <p class="detail">
            Measured while running the database health query.
          </p>
        </article>
      </section>

      <div class="toolbar">
        <span>Checked <time id="checked-at"><%= checkedAt %></time></span>
        <label class="toggle"
          ><input id="auto-refresh" type="checkbox" /> Auto-refresh every 30
          seconds</label
        >
        <button id="refresh" type="button">Refresh status</button>
      </div>

      <footer>
        <span>Runtime monitor</span><span>HTTP <%= httpStatus %></span>
      </footer>
    </main>
    <script>
      const refreshButton = document.querySelector('#refresh');
      const autoRefresh = document.querySelector('#auto-refresh');
      const refresh = () => {
        refreshButton.disabled = true;
        refreshButton.textContent = 'Checking...';
        window.location.reload();
      };
      refreshButton.addEventListener('click', refresh);
      autoRefresh.addEventListener('change', () => {
        if (autoRefresh.checked)
          window.healthTimer = window.setInterval(refresh, 30000);
        else window.clearInterval(window.healthTimer);
      });
    </script>
  </body>
</html>
