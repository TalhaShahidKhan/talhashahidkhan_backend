{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "src/views/**/*",
          "views/**/*",
          "prisma/**/*",
          "generated/**/*",
          "node_modules/.pnpm/swagger-ui-dist@*/node_modules/swagger-ui-dist/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ]
}

