# Environment Configuration
# Copy to .env and fill in values — NEVER commit the .env file

NODE_ENV=development
VERCEL=false

# Database — use a strong, unique password
DATABASE_URL=

# Admin seed account — use a strong password (min 10 chars, mixed case, digit, special char)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=admin-api
JWT_AUDIENCE=admin-panel
JWT_EXPIRES_IN=15m

# SMTP mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# CORS — comma-separated allowed origins (required in production, defaults to * in dev)
# Example: https://talhashahidkhan.com,https://admin.talhashahidkhan.com
CORS_ORIGINS=